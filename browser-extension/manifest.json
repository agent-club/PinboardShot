{
  "manifest_version": 3,
  "name": "PinboardShot Browser Capture",
  "description": "Capture long web pages into PinboardShot.",
  "version": "0.2.0",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["activeTab", "scripting", "nativeMessaging", "sidePanel"],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "PinboardShot 长截图", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" } },
  "side_panel": { "default_path": "popup.html" },
  "commands": {
    "start-long-screenshot": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "Start a PinboardShot long screenshot"
    }
  }
}
