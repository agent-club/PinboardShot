{
  "name": "pinboardshot-site",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "check:app-version": "node scripts/check-app-version.mjs",
    "generate:hero-art": "node scripts/generate-hero-pinboard.mjs",
    "generate:og": "node scripts/generate-og.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "pnpm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "check:cloudflare": "vinext check",
    "deploy:dry-run": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext deploy --dry-run",
    "deploy": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext deploy",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.7",
      "@esbuild-kit/core-utils>esbuild": "0.25.12",
      "fast-uri": "3.1.4",
      "js-yaml": "4.3.0",
      "minimatch@3.1.5>brace-expansion": "1.1.16",
      "minimatch@10.2.5>brace-expansion": "5.0.8",
      "postcss": "8.5.22",
      "sharp": "0.35.2"
    },
    "onlyBuiltDependencies": [
      "esbuild@0.25.12 || 0.28.1",
      "unrs-resolver@1.12.2",
      "workerd@1.20260722.1"
    ]
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vinext": "0.2.1",
    "vite": "8.2.2",
    "wrangler": "4.127.0"
  },
  "type": "module"
}
